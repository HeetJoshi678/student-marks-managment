// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  password       String          // Hashed password
  role           String          @default("STUDENT") // ADMIN, TEACHER, STUDENT
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations to Profiles
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  
  // Security logs
  activityLogs   ActivityLog[]
  loginHistories LoginHistory[]
}

model StudentProfile {
  id               String             @id @default(uuid())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  rollNumber       String             @unique
  classGrade       String             // e.g. "Class 10A", "Grade 11B"
  
  // New profile metadata
  photoUrl         String?
  phone            String?
  address          String?
  dob              DateTime?
  gender           String?
  academicHistory  String?            // Previous school and grades history JSON/Text
  
  // New relational metrics
  marks            Mark[]
  attendanceRecords AttendanceRecord[]
  badges           Badge[]
}

model TeacherProfile {
  id       String    @id @default(uuid())
  userId   String    @unique
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  subjects Subject[]
}

model Subject {
  id               String          @id @default(uuid())
  name             String          // e.g. "Mathematics", "Science"
  teacherProfileId String
  teacherProfile   TeacherProfile  @relation(fields: [teacherProfileId], references: [id])
  
  marks            Mark[]
}

model Mark {
  id            String         @id @default(uuid())
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  examType      String         // e.g. "Quiz 1", "Midterm", "Final"
  marksObtained Float
  maxMarks      Float          @default(100)
  term          String         // e.g. "Term 1", "Term 2"
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([studentId, subjectId, examType, term])
}

model AttendanceRecord {
  id         String         @id @default(uuid())
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date       DateTime
  status     String         // PRESENT, ABSENT, LATE
  createdAt  DateTime       @default(now())

  @@unique([studentId, date])
}

model Badge {
  id          String         @id @default(uuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name        String         // Top Performer, Most Improved, Perfect Attendance, Subject Topper
  description String
  icon        String         // trophy, star, calendar, trending-up
  awardedAt   DateTime       @default(now())
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // e.g. "UPDATE_MARKS", "LOGIN", "BULK_IMPORT"
  details   String
  createdAt DateTime @default(now())
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}
